# Windows batch files MUST have CRLF line endings. cmd.exe mis-parses LF-only
# scripts - multi-line if blocks and pipes break in confusing ways.
*.cmd text eol=crlf
*.bat text eol=crlf

# Everything else is fine with LF in the repo.
*.js   text eol=lf
*.json text eol=lf
*.css  text eol=lf
*.html text eol=lf
*.md   text eol=lf
