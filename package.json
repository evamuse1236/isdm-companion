{
  "name": "isdm-companion",
  "version": "1.0.0",
  "private": true,
  "description": "Repository tooling and tests for the ISDM Companion Android beta.",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "setup": "node scripts/task.mjs setup",
    "dev": "node scripts/task.mjs dev",
    "dev:dashboard": "npm --prefix beta-dashboard run dev",
    "test": "node scripts/task.mjs test",
    "test:node": "node --experimental-strip-types --test tests/*.test.mjs",
    "verify": "node scripts/task.mjs verify",
    "beta:release": "node scripts/send-beta-release.mjs"
  }
}
