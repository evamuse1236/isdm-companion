# Copy this file to .env and fill in your LMS credentials.
# .env is gitignored and never leaves your machine.

LMS_EMAIL=you@pgp.isdm.org.in
LMS_PASSWORD=your-lms-password

# Port for the local dashboard
PORT=4321

# Windows toast notification when a class opens for marking (1 = on, 0 = off)
NOTIFY=1

# How long after a class starts you are still counted on time (minutes).
# Used only for the countdown shown in the UI.
LATE_AFTER_MINUTES=10

# ---------------------------------------------------------------------------
# Auto-marking. Off by default, and you should think before turning it on.
#
# With AUTO_MARK=1 the app marks you present the moment the LMS opens a class,
# without asking. That is only honest if the app is running *because you are
# sitting in the class* — otherwise it will record you present for sessions you
# never attended, which is a misrepresentation your institution acts on.
#
# The arming window below is the safety catch: auto-marking stays active for
# AUTO_MARK_HOURS after the server starts (or after you flip the switch in the
# UI), then stops until you arm it again. Keep it short.
#
# Do NOT combine AUTO_MARK=1 with launching this app at Windows startup. That
# removes the "I opened it because I'm here" signal entirely and the app will
# mark you present every single class day, including ones you sleep through.
# ---------------------------------------------------------------------------
AUTO_MARK=0
AUTO_MARK_HOURS=3

# Optional. Leave blank to auto-detect from your own attendance sessions.
# Example: COHORTS=Section A,Group 1
COHORTS=
