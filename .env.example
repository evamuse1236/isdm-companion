# Copy this file to .env and fill in your LMS credentials.
# .env is gitignored and never leaves your machine.

LMS_EMAIL=you@pgp.isdm.org.in
LMS_PASSWORD=your-lms-password

# Port for the local dashboard
PORT=4321

# Windows toast notification when a class opens for marking (1 = on, 0 = off)
NOTIFY=1

# How long after a class starts you are still counted on time (minutes).
# Used only for the countdown shown in the UI.
LATE_AFTER_MINUTES=10

# ---------------------------------------------------------------------------
# Auto-marking. Off by default, and worth a thought before turning it on.
#
# With AUTO_MARK=1 the app marks you present the moment the LMS opens a class,
# without asking. That is only honest if the app is running *because you are
# sitting in the class* - otherwise it records you present for sessions you
# never attended, which is a misrepresentation your institution acts on.
#
# Two guards keep that from drifting:
#   - SHUTDOWN_AT stops the app at the end of the teaching day.
#   - Auto-marking never carries into a new calendar day, so a server left
#     running overnight cannot mark you into tomorrow's first class.
#
# AUTO_MARK_HOURS adds a shorter expiry on top. 0 means "for as long as the
# app is open", which is the usual pairing with a daily shutdown.
#
# Do NOT combine AUTO_MARK=1 with launching this app at Windows startup. That
# removes the "I opened it because I'm here" signal entirely.
# ---------------------------------------------------------------------------
AUTO_MARK=0
AUTO_MARK_HOURS=0

# Stop the server at this time each day, HH:MM, 24-hour. Blank = never stop.
SHUTDOWN_AT=18:00

# Stop Windows dropping into Modern Standby while the app runs (1 = on).
# A suspended laptop has its networking cut, so a class that opens while it is
# asleep is simply missed - this is the difference between auto-marking working
# and not. It blocks *idle* sleep only; closing the lid still suspends.
# Costs battery, so turn it off if you are running on a low charge.
KEEP_AWAKE=0

# Which floor each room is on, so you know where to go. Extend as you learn them.
ROOM_FLOORS=Sahyog:3,Majlis:6

# Detail kept in logs/YYYY-MM-DD.log and the dashboard's Log tab.
# debug logs a lot more; info is plenty for day-to-day.
LOG_LEVEL=info

# Optional. Leave blank to auto-detect from your own attendance sessions.
# Example: COHORTS=Section A,Group 1
COHORTS=
